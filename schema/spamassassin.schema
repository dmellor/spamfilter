--
-- Name: spam_tests(integer); Type: FUNCTION; Schema: public; Owner: david
--

CREATE FUNCTION public.spam_tests(spam integer) RETURNS text
    LANGUAGE plpgsql
    AS $$
declare
    test record;
    result text;
begin
    result := '';
    for test in select name from spam_tests where spam_id = spam loop
        result := result || ',' || test.name;
    end loop;

    if result != '' then
       result := substring(result from 2);
    end if;

    return result;
end;
$$;


ALTER FUNCTION public.spam_tests(spam integer) OWNER TO david;

